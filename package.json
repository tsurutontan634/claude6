{
  "name": "life-utility-maximizer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "人生の効用最大化シミュレーター — 1対1の質問で自分の効用関数を推定し、時間・お金・人生計画の最適配分を提案する",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "build:single": "tsc --noEmit && vite build --mode single",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.1",
    "typescript": "5.9.3",
    "vite": "8.3.1",
    "vite-plugin-singlefile": "2.3.3",
    "vitest": "5.0.1"
  }
}
